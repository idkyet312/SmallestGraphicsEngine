# Tool output
graphify-out/
Content/Cooked/
# Baked DDGI probe caches, written next to the levels they belong to. Derived
# from level content and keyed by hash, so they regenerate on demand.
Content/Levels/.ddgi/
assetcache/
dumps/
Content/Models/ship.glb

# Ad hoc shader disassembly captured when verifying a refactor is pure
# (compile before/after, compare sizes). Derived output, never source.
*.dxil
temp_dxil/

# PIX GPU captures and the exports taken alongside them. A single .wpix runs to
# hundreds of MB and is a recording of one run, not source.
*.wpix
GPU*-events.csv
GPU*-screenshot.png

# Redistributable packages built by scripts/package-release.ps1. The staged tree
# carries a copy of Content, so this runs to several GB -- it is build output,
# rebuildable from the script, and must never enter history.
dist/
dist-test/

# Source heightmap stamps for the terrain Stamp tool: 52 4096x4096 16-bit PNGs,
# ~825 MB. They are a third-party library, not engine source, and the loader
# degrades gracefully when the folder is absent (DiscoverTerrainStampNames
# returns empty and the Stamp tool reports "No stamps found"). Supply your own
# copy under this path to author with them.
Content/Textures/Stamps/
